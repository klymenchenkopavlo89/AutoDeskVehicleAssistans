<Page x:Class="ToyotaVehicleSystemWPF.ServiceInformationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="1000"
      Title="Service Information">

    <Grid Background="#1E1E1E">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,35,0,30">

            <TextBlock Text="SERVICE INFORMATION"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Toyota Maintenance"
                       FontSize="16"
                       Foreground="#E60012"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- SERVICE DETAILS -->
        <Border Grid.Row="1"
                Background="#252525"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="8"
                Margin="60,0,60,20"
                Padding="35">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: SERVICE DETAILS -->
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,0,25,0">

                    <TextBlock Text="SERVICE TYPE"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#E60012"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Oil Change"
                               FontSize="20"
                               Foreground="White"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="DESCRIPTION"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#E60012"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Engine oil and oil filter replacement"
                               FontSize="20"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="SERVICE INTERVAL"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#E60012"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="10,000 km"
                               FontSize="20"
                               Foreground="White"/>
                </StackPanel>

                <!-- RIGHT: SERVICE IMAGE -->
                <Image x:Name="ServiceImage"
                       Grid.Column="1"
                       Source="/Images/Service01.png"
                       Width="500"
                       Height="300"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- BACK BUTTON -->
        <Button Grid.Row="2"
                Content="BACK"
                Width="150"
                Height="45"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Background="#333333"
                BorderBrush="#555555"
                BorderThickness="1"
                HorizontalAlignment="Left"
                Cursor="Hand"
                Margin="30,10,0,25"
                Click="BackButton_Click"/>

    </Grid>
</Page>
