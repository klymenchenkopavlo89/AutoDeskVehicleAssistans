<Window x:Class="ToyotaVehicleSystemWPF.VehicleInformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToyotaVehicleSystemWPF"
        mc:Ignorable="d"
        Title="VehicleInformationWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="40">

            <TextBlock Text="VEHICLE INFORMATION"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,30"/>

            <TextBlock x:Name="VinTextBlock"
                   FontSize="18"
                   Margin="0,0,0,10"/>

            <TextBlock x:Name="ModelTextBlock"
                   FontSize="18"
                   Margin="0,0,0,10"/>

            <TextBlock x:Name="YearTextBlock"
                   FontSize="18"
                   Margin="0,0,0,10"/>

            <TextBlock x:Name="EngineTextBlock"
                   FontSize="18"
                   Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal">

                <Button Content="SERVICE"
        Width="150"
        Height="45"
        Margin="0,0,15,0"
        Click="ServiceButton_Click"/>

                <Button Content="PARTS"
                    Width="150"
                    Height="45"
                    Margin="0,0,15,0"
                    Click="PartsButton_Click"/>

                <Button Content="BACK"
        Width="150"
        Height="45"
        Click="BackButton_Click"/>

            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
