<Page x:Class="ToyotaVehicleSystemWPF.ModelSearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="1000"
      Title="Search by Model">

    <Grid Background="#1E1E1E">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,30">

            <TextBlock Text="SEARCH BY MODEL"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Select a Toyota vehicle"
                       FontSize="15"
                       Foreground="#BDBDBD"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

        </StackPanel>

        <!-- MAIN CONTENT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- VEHICLE LIST -->

            <StackPanel Grid.Column="0">

                <TextBlock Text="VEHICLES"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#BDBDBD"
                           Margin="0,0,0,15"/>

                <Button Content="PRIUS"
                        Tag="Prius"
                        Height="52"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#E60012"
                        BorderThickness="0"
                        Margin="0,0,0,12"
                        Cursor="Hand"
                        Click="ModelButton_Click"/>

                <Button Content="COROLLA"
                        Tag="Corolla"
                        Height="52"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#333333"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        Margin="0,0,0,12"
                        Cursor="Hand"
                        Click="ModelButton_Click"/>

                <Button Content="RAV4"
                        Tag="RAV4"
                        Height="52"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#333333"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="ModelButton_Click"/>

            </StackPanel>

            <!-- VEHICLE INFORMATION -->

            <Border Grid.Column="1"
                    Background="#252525"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="30,0,0,0"
                    Padding="25">

                <StackPanel>

                    <TextBlock Text="VEHICLE INFORMATION"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- NO VEHICLE SELECTED -->

                    <TextBlock x:Name="SelectVehicleText"
           Text="CHOOSE A MODEL"
           FontSize="24"
           FontWeight="Bold"
           Foreground="#E60012"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Margin="0,35,0,20"/>

                    <Image x:Name="DefaultVehicleImage"
       Source="/Images/ArrowModelsMenu.png"
       Width="280"
       Height="120"
       Stretch="Uniform"
       HorizontalAlignment="Center"
       Margin="0,0,0,20"/>

                    <!-- VEHICLE IMAGE -->

                    <Image x:Name="VehicleImage"
                           Width="320"
                           Height="200"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"
                           Visibility="Collapsed"/>

                    <!-- VEHICLE DETAILS -->

                    <TextBlock x:Name="ModelTextBlock"
                               FontSize="17"
                               Foreground="#D0D0D0"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="YearTextBlock"
                               FontSize="17"
                               Foreground="#D0D0D0"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="EngineTextBlock"
                               FontSize="17"
                               Foreground="#D0D0D0"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="VinTextBlock"
                               FontSize="17"
                               Foreground="#D0D0D0"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>

                    <!-- MORE INFORMATION -->

                    <Button x:Name="MoreInformationButton"
                            Content="MORE INFORMATION"
                            Width="220"
                            Height="48"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#E60012"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="MoreInformationButton_Click"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- BACK -->

        <Button Grid.Row="2"
                Content="BACK"
                Width="130"
                Height="42"
                HorizontalAlignment="Left"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Background="#333333"
                BorderBrush="#555555"
                BorderThickness="1"
                Cursor="Hand"
                Margin="0,20,0,0"
                Click="BackButton_Click"/>

    </Grid>

</Page>
