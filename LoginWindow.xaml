<Window x:Class="ToyotaVehicleSystemWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toyota Vehicle System - Login"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Grid Background="#1E1E1E">

        <StackPanel Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- TOYOTA LOGO -->

            <Image Source="/Images/TLogo.png"
                   Width="170"
                   Height="170"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

            <!-- TITLE -->

            <TextBlock Text="TOYOTA"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="VEHICLE SYSTEM"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#E60012"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,35"/>

            <!-- LOGIN -->

            <TextBlock Text="USERNAME"
                       Foreground="#CCCCCC"
                       FontSize="13"
                       Margin="0,0,0,7"/>

            <TextBox x:Name="UsernameBox"
                     Height="45"
                     FontSize="16"
                     Padding="10"
                     Background="#333333"
                     Foreground="White"
                     BorderBrush="#555555"
                     BorderThickness="1"
                     Margin="0,0,0,20"/>

            <!-- PASSWORD -->

            <TextBlock Text="PASSWORD"
                       Foreground="#CCCCCC"
                       FontSize="13"
                       Margin="0,0,0,7"/>

            <PasswordBox x:Name="PasswordBox"
                         Height="45"
                         FontSize="16"
                         Padding="10"
                         Background="#333333"
                         Foreground="White"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         Margin="0,0,0,30"/>

            <!-- LOGIN BUTTON -->

            <Button Content="LOGIN"
                    Height="52"
                    FontSize="17"
                    FontWeight="Bold"
                    Foreground="White"
                    Background="#E60012"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LoginButton_Click"/>

            <!-- STATUS -->

            <TextBlock x:Name="StatusText"
                       Foreground="#E60012"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>

            <!-- VERSION -->

            <TextBlock Text="Prototype • Version 1.0"
                       Foreground="#777777"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,0"/>

        </StackPanel>

    </Grid>
</Window>
