<Page x:Class="ToyotaVehicleSystemWPF.PartsInformationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600"
      d:DesignWidth="1000"
      Title="Parts Information">

    <Grid Background="#1E1E1E">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,35,0,30">

            <TextBlock Text="PARTS INFORMATION"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Genuine Toyota Parts"
                       FontSize="16"
                       Foreground="#E60012"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

        </StackPanel>

        <!-- PARTS INFORMATION -->

        <Border Grid.Row="1"
                Background="#252525"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="8"
                Margin="60,0,60,20"
                Padding="35">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="OIL FILTER"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#E60012"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Genuine Toyota"
                           FontSize="20"
                           Foreground="White"
                           Margin="0,0,0,25"/>

                <TextBlock Text="AIR FILTER"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#E60012"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Genuine Toyota"
                           FontSize="20"
                           Foreground="White"
                           Margin="0,0,0,25"/>

                <TextBlock Text="ENGINE OIL"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#E60012"
                           Margin="0,0,0,8"/>

                <TextBlock Text="5W-30"
                           FontSize="20"
                           Foreground="White"/>

            </StackPanel>

        </Border>

        <!-- BACK BUTTON -->

        <Button Grid.Row="2"
                Content="BACK"
                Width="150"
                Height="45"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Background="#333333"
                BorderBrush="#555555"
                BorderThickness="1"
                HorizontalAlignment="Left"
                Cursor="Hand"
                Margin="30,10,0,25"
                Click="BackButton_Click"/>

    </Grid>
</Page>
