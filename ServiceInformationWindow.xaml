<Window x:Class="ToyotaVehicleSystemWPF.ServiceInformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToyotaVehicleSystemWPF"
        mc:Ignorable="d"
        Title="ServiceInformationWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="40">

            <TextBlock Text="SERVICE INFORMATION"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,30"/>

            <TextBlock Text="Service Type: Oil Change"
                   FontSize="18"
                   Margin="0,0,0,10"/>

            <TextBlock Text="Description: Engine oil and oil filter replacement"
                   FontSize="18"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

            <TextBlock Text="Interval: 10000 km"
                   FontSize="18"
                   Margin="0,0,0,30"/>

            <Button Content="BACK"
                Width="150"
                Height="45"
                Click="BackButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
